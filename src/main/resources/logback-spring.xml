<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 配置日志上下文名称 -->
    <contextName>NaiLong-platform</contextName>
    
    <!-- 日志目录：可用环境变量 LOG_PATH 覆盖，默认项目下 logs/ -->
    <property name="LOG_HOME" value="${LOG_PATH:-logs}" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    <property name="LOG_FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 控制台输出的日志级别过滤 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>
    
    <!-- 开发环境控制台输出（特殊配置） -->
    <appender name="DEV_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- 开发环境使用更丰富的颜色 -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 开发环境控制台输出全部日志 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>
    
    <!-- 普通日志文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径 -->
        <file>${LOG_HOME}/NaiLong-platform.log</file>
        
        <!-- 滚动策略：按日期滚动，保留30天 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 滚动文件命名格式 -->
            <fileNamePattern>${LOG_HOME}/NaiLong-platform.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 最大保留时间 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小限制 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 日志格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 文件输出的日志级别过滤 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>
    
    <!-- 错误日志文件输出 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 错误日志文件路径 -->
        <file>${LOG_HOME}/NaiLong-platform-error.log</file>
        
        <!-- 滚动策略：按日期滚动，保留30天 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 滚动文件命名格式 -->
            <fileNamePattern>${LOG_HOME}/NaiLong-platform-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 最大保留时间 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小限制 -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 日志格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 只输出ERROR级别日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>
    
    <!-- 业务日志文件输出 -->
    <appender name="BUSINESS_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 业务日志文件路径 -->
        <file>${LOG_HOME}/NaiLong-platform-business.log</file>
        
        <!-- 滚动策略：按日期滚动，保留90天 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 滚动文件命名格式 -->
            <fileNamePattern>${LOG_HOME}/NaiLong-platform-business.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 最大保留时间 -->
            <maxHistory>90</maxHistory>
            <!-- 总大小限制 -->
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 日志格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 文件输出的日志级别过滤 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>
    
    <!-- 开发环境日志配置 -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="DEV_CONSOLE" />
        </root>
        
        <!-- 自定义包路径的日志级别 -->
        <logger name="com.nailong" level="DEBUG" additivity="false">
            <appender-ref ref="DEV_CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </logger>
        
        <!-- 第三方框架的日志级别 -->
        <logger name="org.springframework" level="INFO" />
        <logger name="org.mybatis" level="DEBUG" />
        <logger name="com.baomidou" level="DEBUG" />
        <logger name="org.hibernate" level="INFO" />
        <logger name="org.apache" level="INFO" />
        <logger name="javax.servlet" level="INFO" />
    </springProfile>
    
    <!-- 生产环境日志配置 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
        
        <!-- 自定义包路径的日志级别 -->
        <logger name="com.nailong" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
            <appender-ref ref="BUSINESS_LOG" />
        </logger>
        
        <!-- 第三方框架的日志级别 -->
        <logger name="org.springframework" level="WARN" />
        <logger name="org.mybatis" level="INFO" />
        <logger name="com.baomidou" level="INFO" />
        <logger name="org.hibernate" level="WARN" />
        <logger name="org.apache" level="WARN" />
        <logger name="javax.servlet" level="WARN" />
    </springProfile>
    
    <!-- 其他环境默认日志配置 -->
    <springProfile name="!prod,!dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
        
        <!-- 自定义包路径的日志级别 -->
        <logger name="com.nailong" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </logger>
    </springProfile>
</configuration>